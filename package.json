{
  "name": "markmap-plus",
  "version": "0.4.1",
  "description": "Markmap mindmap preview for VS Code — an actively maintained fork of markmap-vscode with keyboard shortcuts, node search and more",
  "author": "Xiao-Chenguang",
  "contributors": [
    "Gerald <gera2ld@live.com> (original markmap-vscode)"
  ],
  "license": "MIT",
  "displayName": "Markmap Plus",
  "publisher": "cgxiao",
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Visualization"
  ],
  "keywords": [
    "markmap",
    "mindmap",
    "mind map",
    "markdown",
    "outline",
    "visualization",
    "fork"
  ],
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "markmap-plus.open",
        "category": "Markmap Plus",
        "title": "Open as markmap",
        "icon": {
          "light": "./assets/light.svg",
          "dark": "./assets/dark.svg"
        }
      },
      {
        "command": "markmap-plus.toggle",
        "category": "Markmap Plus",
        "title": "Toggle the active node"
      },
      {
        "command": "markmap-plus.toggle-recursively",
        "category": "Markmap Plus",
        "title": "Toggle the active node recursively"
      }
    ],
    "customEditors": [
      {
        "viewType": "markmap-plus.markmap",
        "displayName": "Markmap Plus",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "when": "editorLangId == markdown || editorLangId == mdx",
          "command": "markmap-plus.open"
        },
        {
          "when": "editorLangId == markdown || editorLangId == mdx",
          "command": "markmap-plus.toggle"
        },
        {
          "when": "editorLangId == markdown || editorLangId == mdx",
          "command": "markmap-plus.toggle-recursively"
        }
      ],
      "explorer/context": [
        {
          "when": "resourceLangId == markdown || resourceLangId == mdx",
          "command": "markmap-plus.open",
          "group": "navigation"
        }
      ],
      "editor/title": [
        {
          "when": "activeEditor == workbench.editors.files.textFileEditor && (resourceLangId == markdown || resourceLangId == mdx)",
          "command": "markmap-plus.open",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Markmap Plus",
      "properties": {
        "markmapPlus.defaultOptions": {
          "type": "string",
          "default": "",
          "markdownDescription": "Default options for Markmap as JSON, see <https://markmap.js.org/docs/guide/options> for the options. The options in a document win over these, and they do not apply to exported HTML.",
          "editPresentation": "multilineText"
        },
        "markmapPlus.customCSS": {
          "type": "string",
          "default": "",
          "markdownDescription": "Custom CSS for the page around the map. To change colors, set the `--mm-*` properties on `markmap-view`, see <https://markmap.js.org/docs/guide/themes-and-layouts>. Rules cannot reach inside the map, and they do not apply to exported HTML.",
          "editPresentation": "multilineText"
        },
        "markmapPlus.theme": {
          "type": "string",
          "default": "",
          "enum": ["", "classic", "cards", "minimal"],
          "enumDescriptions": [
            "Use the theme from the document's frontmatter, or the default",
            "Classic markmap look",
            "Nodes drawn as cards",
            "Minimal, text-only nodes"
          ],
          "markdownDescription": "Theme for every map. Wins over the `theme` in a document's frontmatter."
        },
        "markmapPlus.layout": {
          "type": "string",
          "default": "",
          "enum": ["", "tree", "two-sided", "org-chart"],
          "enumDescriptions": [
            "Use the layout from the document's frontmatter, or the default",
            "Branches grow to the right",
            "Branches grow to both sides",
            "Top-down organisation chart"
          ],
          "markdownDescription": "Layout for every map. Wins over the `layout` in a document's frontmatter."
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "scripts": {
    "prepare": "husky",
    "vscode:prepublish": "pnpm build",
    "clean": "del-cli dist",
    "build:js": "rolldown -c",
    "build": "pnpm lint:fix && pnpm clean && pnpm build:js",
    "lint": "oxlint && oxfmt --check src",
    "lint:fix": "oxlint --fix && oxfmt src",
    "test:e2e": "pnpm test:e2e:web && pnpm test:e2e:desktop",
    "test:e2e:web": "node e2e/web.mjs",
    "test:e2e:desktop": "node e2e/desktop.mjs",
    "dev:pack": "npx @vscode/vsce pack"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Xiao-Chenguang/markmap-vscode"
  },
  "homepage": "https://github.com/Xiao-Chenguang/markmap-vscode#readme",
  "bugs": {
    "url": "https://github.com/Xiao-Chenguang/markmap-vscode/issues"
  },
  "main": "dist/extension.js",
  "browser": "dist/extension.js",
  "files": [
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "assets",
    "dist"
  ],
  "devDependencies": {
    "@markmap/canvas": "1.1.0",
    "@markmap/core": "1.1.0",
    "@markmap/element": "1.1.0",
    "@markmap/page": "1.1.0",
    "@markmap/plugin-math": "1.1.0",
    "@markmap/render": "1.1.0",
    "@markmap/toolbar": "1.1.0",
    "@markmap/view": "1.1.0",
    "@types/node": "^24.0.1",
    "@types/vscode": "~1.75.0",
    "@types/vscode-webview": "^1.57.5",
    "@vscode/test-web": "^0.0.81",
    "@vscode/vsce": "^4.1.0",
    "del-cli": "^8.0.1",
    "es-toolkit": "^1.39.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "ovsx": "^1.2.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "playwright-core": "^1.65.0",
    "rolldown": "^1.3.0",
    "typescript": "^7.0.2",
    "vscode-uri": "^3.1.0"
  },
  "lint-staged": {
    "*.ts": [
      "oxlint --fix",
      "oxfmt"
    ]
  }
}
